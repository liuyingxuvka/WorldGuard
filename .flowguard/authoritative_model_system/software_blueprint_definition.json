  "dynamic_allowances": [
    {
      "surface_key": "scripts/refresh_world_blueprint_external_dna_fixtures.py#_refresh_external_object_census",
      "operations": [
        "runpy.run_path"
      ],
      "rationale": "The fixture compiler loads only the explicitly named current fixture helper through one bounded author-side path; the loaded path is not a runtime or external-AI reconstruction route."
    },
    {
      "surface_key": "scripts/verify_guard_simulation_readiness.py#_check_package_identity",
      "operations": [
        "importlib.import_module"
      ],
      "rationale": "Readiness checks import exactly the declared installed WorldGuard package identity for source-versus-install evidence; an unavailable or malformed package remains a visible blocker."
    },
    {
      "surface_key": "worldguard/guard_model_contract.py#discover_guard_owned_failure_codes",
      "operations": [
        "importlib.import_module"
      ],
      "rationale": "Failure-code discovery imports the explicitly selected current guard module to bind its native failure vocabulary; it is bounded to the declared guard contract and never a fallback route."
    },
    {
      "surface_key": "worldguard/flowguard_projection.py#require_flowguard_toolchain",
      "operations": [
        "importlib.import_module"
      ],
      "rationale": "The explicit FlowGuard projection boundary imports only the installed current provider module to verify the declared provider surface; an unavailable or incompatible provider remains a visible projection gap."
    },
    {
      "surface_key": "worldguard/flowguard_projection.py#build_flowguard_provider_profile",
      "operations": [
        "importlib.import_module"
      ],
      "rationale": "Provider-profile construction imports the same installed current FlowGuard provider module after the explicit boundary check and instantiates the declared provider-profile type; it is not a fallback or reconstruction path."
    },
    {
      "surface_key": "worldguard/mesh.py#_predictive_axis_assessment",
      "operations": [
        "getattr"
      ],
      "rationale": "Axis assessment reads the declared predictive-axis attribute from one current model node; missing or malformed attributes remain visible evidence gaps."
    },
    {
      "surface_key": "worldguard/semantic.py#_safe_scalar_eval",
      "operations": [
        "eval"
      ],
      "rationale": "Scalar semantic evaluation is restricted to the current bounded expression evaluator and its declared environment; it is not a general execution or reconstruction path."
    }
  ],
